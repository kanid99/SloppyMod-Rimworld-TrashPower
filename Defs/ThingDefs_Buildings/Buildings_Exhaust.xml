<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Exhaust: burning trash makes pollution. Burners send it down this network - Vanilla
		Expanded Framework's PipeSystem, like the hot water - to exhaust ports, which let it out
		where you want it. A burner not piped to a port lets it out around itself, as toxic gas.
		CompExhaust and CompExhaustPort do the work. Works in both play modes.
	-->
	<PipeSystem.PipeNetDef>
		<defName>STB_ExhaustNet</defName>
		<resource>
			<name>Exhaust</name>
			<unit>-</unit>
			<color>(0.45, 0.42, 0.38)</color>
			<onlyShowStored>True</onlyShowStored>
		</resource>
		<pipeDefs>
			<li>STB_ExhaustPipe</li>
			<li>STB_ExhaustPipeHidden</li>
		</pipeDefs>
		<overlayOptions>
			<overlayColor>(0.62, 0.58, 0.50)</overlayColor>
		</overlayOptions>
		<noStorageAlert>true</noStorageAlert>
	</PipeSystem.PipeNetDef>

	<ThingDef Name="STB_ExhaustPipeBase" ParentName="BuildingBase" Abstract="True">
		<thingClass>PipeSystem.Building_Pipe</thingClass>
		<category>Building</category>
		<tickerType>Rare</tickerType>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<blueprintGraphicData>
				<texPath>Things/Building/Linked/STB_ExhaustPipe_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
			<canConstructInCorner>true</canConstructInCorner>
		</building>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<drawStyleCategory>Conduits</drawStyleCategory>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_ExhaustNet</pipeNet>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
		</comps>
		<placeWorkers>
			<li>PipeSystem.PlaceWorker_Pipe</li>
		</placeWorkers>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<!-- Visible and hidden pipe share one architect button. -->
		<designatorDropdown>STB_ExhaustPipes</designatorDropdown>
		<constructEffect>ConstructMetal</constructEffect>
		<clearBuildingArea>false</clearBuildingArea>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<ThingDef ParentName="STB_ExhaustPipeBase">
		<defName>STB_ExhaustPipe</defName>
		<label>exhaust pipe</label>
		<description>Sooty flue pipe that carries exhaust from trash gasifiers to an exhaust port. Can be placed under walls and other buildings.</description>
		<graphicData>
			<texPath>Things/Building/Linked/STB_ExhaustPipe_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom9</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/STB_ExhaustPipe_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>50</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>2</Steel>
		</costList>
	</ThingDef>

	<ThingDef ParentName="STB_ExhaustPipeBase">
		<defName>STB_ExhaustPipeHidden</defName>
		<label>hidden exhaust pipe</label>
		<description>Exhaust pipe buried out of sight. Can be placed under walls and other buildings.</description>
		<graphicData>
			<!-- Vanilla Expanded Framework's own hidden-conduit texture, as VE's hidden pipes use. -->
			<texPath>UI/CSG/IConduit</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom9</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/STB_ExhaustPipe_MenuIcon</uiIconPath>
		<uiIconScale>0.7</uiIconScale>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>240</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>4</Steel>
		</costList>
	</ThingDef>

	<!-- Where the exhaust comes out. Build it outside, somewhere you don't mind polluting. -->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_ExhaustPort</defName>
		<label>exhaust port</label>
		<description>A soot-blackened stack where the exhaust network lets out the fumes of burning trash. The ground around it slowly fills with pollution. Build it outdoors: indoors, it fills the room with toxic gas instead. With several ports on one network, the exhaust is split between them. Its damper closes it. Its draught fan needs power (80W): unpowered, it can't draw the exhaust and the fumes back up and come out around the burners. Run an exhaust pipe under it to connect it. A garbage compactor on the same exhaust network sends its fumes here too.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_ExhaustPort</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.4</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>false</rotatable>
		<size>(1,1)</size>
		<tickerType>Rare</tickerType>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>500</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>-10</Beauty>
		</statBases>
		<costList>
			<Steel>30</Steel>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_ExhaustNet</pipeNet>
			</li>
			<li Class="TrashbrickBurning.CompProperties_ExhaustPort"/>
			<!-- The draught fan: unpowered, the port shuts and the exhaust backs up into the burners. -->
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>80</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable">
				<commandTexture>Things/Building/Linked/STB_HotWaterValve</commandTexture>
				<commandLabelKey>STB_DamperLabel</commandLabelKey>
				<commandDescKey>STB_DamperDesc</commandDescKey>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
		</comps>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<!-- The stack and the wall port share one architect button. -->
		<designatorDropdown>STB_ExhaustPorts</designatorDropdown>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		The wall-mounted port: hung on a wall like a wall lamp or an over-the-wall unit, it lets the
		exhaust out on the side it's hung on. Hang it on the outside of a wall and run the exhaust
		pipe through under the wall to it.
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_ExhaustPortWall</defName>
		<label>wall exhaust port</label>
		<description>An exhaust duct hung on a wall. It blows the fumes of burning trash out on the side of the wall it's hung on: toxic gas, a little heat, and pollution slowly spreading over the ground below it. Hang it on the outside of a wall - on the inside it fills the room with toxic gas. With several ports on one network, the exhaust is split between them. Its damper closes it. Its draught fan needs power (80W): unpowered, it can't draw the exhaust and the fumes back up and come out around the burners. Run an exhaust pipe to the cell it hangs over - pipe can go under the wall. A garbage compactor on the same exhaust network sends its fumes here too.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_ExhaustPortWall</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.3,1.3)</drawSize>
			<!-- Nudged onto the face of the wall it hangs on, as DBH's wall radiators are. -->
			<drawOffsetNorth>(0,0,0.3)</drawOffsetNorth>
			<drawOffsetSouth>(0,0,-0.3)</drawOffsetSouth>
			<drawOffsetEast>(0.3,0,0)</drawOffsetEast>
			<drawOffsetWest>(-0.3,0,0)</drawOffsetWest>
		</graphicData>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>Standable</passability>
		<fillPercent>0</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<size>(1,1)</size>
		<tickerType>Rare</tickerType>
		<clearBuildingArea>false</clearBuildingArea>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>600</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>-5</Beauty>
		</statBases>
		<costList>
			<Steel>35</Steel>
		</costList>
		<building>
			<!-- Hangs on the wall it faces, and comes down with it. -->
			<isAttachment>true</isAttachment>
			<isEdifice>false</isEdifice>
		</building>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_ExhaustNet</pipeNet>
			</li>
			<li Class="TrashbrickBurning.CompProperties_ExhaustPort">
				<outletAtSelf>true</outletAtSelf>
			</li>
			<!-- The draught fan: unpowered, the port shuts and the exhaust backs up into the burners. -->
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>80</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable">
				<commandTexture>Things/Building/Linked/STB_HotWaterValve</commandTexture>
				<commandLabelKey>STB_DamperLabel</commandLabelKey>
				<commandDescKey>STB_DamperDesc</commandDescKey>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
		</comps>
		<placeWorkers>
			<li>Placeworker_AttachedToWall</li>
		</placeWorkers>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<!-- The stack and the wall port share one architect button. -->
		<designatorDropdown>STB_ExhaustPorts</designatorDropdown>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

	<!--
		The exhaust expansion tank: a buffer for when no port can take the exhaust - a power cut, every
		damper shut. Everything on the network fills it instead of gassing its room; it drains into the
		ports once one works again (CompExhaustTank).
	-->
	<ThingDef ParentName="BuildingBase">
		<defName>STB_ExhaustTank</defName>
		<label>exhaust expansion tank</label>
		<description>A sealed tank on the exhaust network that holds the exhaust when no exhaust port can take it - a power cut that stops the ports' draught fans, or every damper shut. While it has room, the burners, garbage compactors and factory machines on the network fill it instead of backing their fumes up into their rooms. It holds about 30,000 toxic gas - roughly eight hours of a trash gasifier on normal - and once a port is working again it drains into the ports over about two hours. When it's full, the exhaust backs up as before. If it's destroyed or taken apart, everything inside comes out at once. Run an exhaust pipe under it to connect it.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Power/STB_ExhaustTank</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>150</pathCost>
		<fillPercent>0.9</fillPercent>
		<blockWind>true</blockWind>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>false</rotatable>
		<size>(2,2)</size>
		<tickerType>Rare</tickerType>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>2000</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>-12</Beauty>
		</statBases>
		<costList>
			<Steel>120</Steel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>STB_ExhaustNet</pipeNet>
			</li>
			<li Class="TrashbrickBurning.CompProperties_ExhaustTank">
				<capacity>30000</capacity>
				<drainPerDay>360000</drainPerDay>
			</li>
			<!-- Build buttons for every other building in the mod (CompBuildShortcuts). -->
			<li Class="TrashbrickBurning.CompProperties_BuildShortcuts"/>
		</comps>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>Electricity</li>
			<li>VRecyclingE_ComplexRecycling</li>
		</researchPrerequisites>
	</ThingDef>

</Defs>
